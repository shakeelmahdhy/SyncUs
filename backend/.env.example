# Copy to backend/.env and fill in real values. Never commit .env.

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
SUPABASE_SECRET_KEY=sb_secret_<your-secret-key>

# Project Settings → API → JWT Secret (verify access tokens in FastAPI)
SUPABASE_JWT_SECRET=<your-jwt-secret>

# Optional: dev-only helper in tracking/deps.py (not used by routes after JWT wiring)
# SYNCUS_DEV_USER_ID=00000000-0000-0000-0000-000000000001
