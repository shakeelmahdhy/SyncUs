# Copy to backend/.env and fill in real values. Never commit .env.

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
SUPABASE_SECRET_KEY=sb_secret_<your-secret-key>
# Required for legacy HS256 JWTs only. ES256 tokens are verified via JWKS (SUPABASE_URL).
SUPABASE_JWT_SECRET=<legacy-jwt-secret-from-dashboard>
